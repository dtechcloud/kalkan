{
  "$comment": "kalkan target manifest runs/<run-id>/target-manifest.json (docs/ENGINE-SPEC.md sections 10 and 11.1). Paths in excluded and neutralized are relative to the target root, with forward slashes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "source",
    "kind",
    "source_dir",
    "git_ref",
    "copy",
    "files",
    "excluded",
    "neutralized",
    "neutralized_count",
    "tech"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9](?:[a-z0-9-]{0,22}[a-z0-9])?-[0-9a-f]{4}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute POSIX path of the local folder, or the git URL without credentials."
    },
    "kind": {
      "type": "string",
      "enum": [
        "path",
        "git"
      ]
    },
    "source_dir": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ],
      "description": "Absolute POSIX path of the private history copy <run>/source (a git URL clone, or a mirror of a local work tree), or null when the run has no history copy. Never the original folder."
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "detail"
      ],
      "description": "Optional. How the run got its private history copy (docs/ENGINE-SPEC.md section 10).",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "cloned",
            "copied",
            "none",
            "failed"
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "git_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "requested_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Optional. The tag, branch or commit of run init --ref; git_ref holds the resolved commit."
    },
    "copy": {
      "type": "string",
      "const": "target"
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copied",
        "bytes",
        "directories",
        "skipped"
      ],
      "properties": {
        "copied": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "directories": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "description": "Sum of the excluded counts."
        }
      }
    },
    "excluded": {
      "type": "array",
      "description": "One entry per skipped path class, in a fixed order, also when the count is 0.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class",
          "count",
          "paths",
          "truncated"
        ],
        "properties": {
          "class": {
            "type": "string",
            "enum": [
              ".git",
              "node_modules",
              ".venv",
              "venv",
              "__pycache__",
              ".tox",
              ".mypy_cache",
              ".pytest_cache",
              "dist",
              "build",
              ".next",
              ".nuxt",
              ".tools",
              "dotnet-build",
              "kalkan-runs",
              "symlink",
              "large-file",
              "special-file",
              "unsafe-name",
              "unreadable",
              "copy-error"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "paths": {
            "type": "array",
            "description": "At most 200 paths; truncated is true when count is larger.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "truncated": {
            "type": "boolean"
          }
        }
      }
    },
    "neutralized": {
      "type": "array",
      "description": "At most 1000 entries; neutralized_count holds the full number.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "area",
          "path",
          "renamed_to",
          "kind"
        ],
        "properties": {
          "area": {
            "type": "string",
            "enum": [
              "target",
              "source"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "renamed_to": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "directory"
            ]
          }
        }
      }
    },
    "neutralized_count": {
      "type": "integer",
      "minimum": 0
    },
    "tech": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "node",
          "next",
          "express",
          "react",
          "vue",
          "angular",
          "nestjs",
          "fastify",
          "koa",
          "hono",
          "python",
          "django",
          "flask",
          "fastapi",
          "go",
          "java",
          "spring",
          "kotlin",
          "ruby",
          "rails",
          "php",
          "laravel",
          "symfony",
          "dotnet",
          "rust",
          "docker",
          "docker-compose",
          "terraform",
          "kubernetes",
          "helm",
          "github-actions",
          "solidity",
          "c",
          "cpp"
        ]
      }
    },
    "long_paths": {
      "type": "object",
      "additionalProperties": false,
      "description": "Windows only: copied files whose absolute path (under the resolved target folder) has 260 or more characters. Opengrep may skip them without a warning (kalkan.util.winpath).",
      "required": [
        "limit",
        "count",
        "paths"
      ],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "condition": {
          "type": "string",
          "description": "Optional. The measured skip condition."
        },
        "root_length": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional. Characters of the resolved target folder path."
        },
        "long_paths_enabled": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional. The LongPathsEnabled registry value; null when unknown. It does not lift the Opengrep limit."
        }
      }
    },
    "deployments": {
      "type": "object",
      "description": "Deployment descriptions of the target copy (kalkan.findings.deployment): the sets by kind and folder or file, the deployment files (at most 5000) and whether the list is cut.",
      "additionalProperties": false,
      "required": [
        "sets",
        "files",
        "truncated"
      ],
      "properties": {
        "sets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "path",
              "files"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "compose",
                  "helm",
                  "kubernetes",
                  "kustomize",
                  "terraform",
                  "bicep"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "files": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "truncated": {
          "type": "boolean"
        }
      }
    }
  }
}
