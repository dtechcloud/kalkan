{
  "$comment": "kalkan candidate record (docs/ENGINE-SPEC.md section 4): a pre-verdict signal from a deterministic engine. kalkan.schema.validator interprets this schema; kalkan.findings.validate.validate_candidate adds the checks that the schema cannot express.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CAND-[0-9A-F]{16}$"
    },
    "engine": {
      "type": "string",
      "enum": [
        "trivy",
        "checkov",
        "hadolint",
        "gitleaks",
        "gitleaks-history",
        "opengrep",
        "bandit",
        "gosec",
        "osv-scanner",
        "grype",
        "govulncheck",
        "retirejs",
        "syft",
        "matcher",
        "zizmor",
        "actionlint",
        "poutine",
        "scorecard",
        "kingfisher",
        "kingfisher-history",
        "shellcheck",
        "flawfinder",
        "gixy",
        "helm-checkov",
        "vacuum",
        "opengrep-packs"
      ]
    },
    "rule_id": {
      "type": "string"
    },
    "class": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "cwe": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CWE-[0-9]+$"
      }
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "file": {
      "type": "string",
      "description": "Target-relative POSIX path; empty for a result without a file."
    },
    "start_line": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "end_line": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "snippet": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "tool_severity": {
      "type": "string"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        null
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fingerprints": {
      "type": "object",
      "description": "SARIF partialFingerprints; validate_candidate checks the string values."
    },
    "sca": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ecosystem": {
              "type": "string"
            },
            "package": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "vuln_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fixed_versions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cvss_score": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "cvss_vector": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "ecosystem",
            "package",
            "version",
            "vuln_ids",
            "fixed_versions",
            "cvss_score",
            "cvss_vector"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "raw": {
      "type": "object",
      "properties": {
        "sarif_file": {
          "type": "string"
        },
        "run_index": {
          "type": "integer",
          "minimum": 0
        },
        "result_index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "sarif_file",
        "run_index",
        "result_index"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "engine",
    "rule_id",
    "class",
    "cwe",
    "title",
    "message",
    "file",
    "start_line",
    "end_line",
    "snippet",
    "severity",
    "tool_severity",
    "confidence",
    "tags",
    "fingerprints",
    "sca",
    "raw"
  ],
  "additionalProperties": false
}
