{
  "type": "object",
  "additionalProperties": false,
  "$comment": "kalkan critic task result (docs/ENGINE-SPEC.md section 18). covered_ids is optional. The engine checks every closure and its quotes.",
  "required": [
    "task_id",
    "missing_units",
    "reassign_ids",
    "stop",
    "notes"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^T[0-9]{4,}-critic$"
    },
    "missing_units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface_id",
          "class",
          "reason",
          "starting_paths"
        ],
        "properties": {
          "surface_id": {
            "type": "string",
            "minLength": 1,
            "description": "A recon surface ID, or a short name for a surface that recon missed."
          },
          "class": {
            "type": "string",
            "enum": [
              "sqli",
              "nosqli",
              "os-command-injection",
              "code-injection",
              "ssti",
              "xss",
              "ssrf",
              "path-traversal",
              "file-upload",
              "xxe",
              "deserialization",
              "authn",
              "jwt",
              "oauth-oidc-saml",
              "missing-authz",
              "idor",
              "multi-tenant",
              "csrf",
              "open-redirect",
              "cors",
              "mass-assignment",
              "business-logic",
              "race-condition",
              "crypto",
              "hardcoded-secrets",
              "sensitive-data-exposure",
              "security-misconfig",
              "graphql",
              "prototype-pollution",
              "dos-redos",
              "request-smuggling-crlf-cache",
              "webhook-replay",
              "rate-limit-bruteforce",
              "llm-ai",
              "memory-safety",
              "smart-contract",
              "mobile-desktop-ipc",
              "vulnerable-dependency",
              "malicious-dependency",
              "supply-chain-cicd",
              "iac-cloud-container",
              "code-quality"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true
          },
          "starting_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Target-relative POSIX path."
            }
          }
        }
      }
    },
    "reassign_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "coverage_id",
          "reason"
        ],
        "properties": {
          "coverage_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true
          }
        }
      }
    },
    "covered_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "$comment": "A blocked unit whose unresolved facts the covered_by units already settled. The evidence quotes the deciding code from files in their reviewed_paths.",
        "required": [
          "coverage_id",
          "covered_by",
          "reason",
          "evidence"
        ],
        "properties": {
          "coverage_id": {
            "type": "string",
            "minLength": 1
          },
          "covered_by": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "line",
                "quote"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Target-relative POSIX path."
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Exact text from the cited line or the two lines around it."
                }
              }
            }
          }
        }
      }
    },
    "stop": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    }
  }
}
