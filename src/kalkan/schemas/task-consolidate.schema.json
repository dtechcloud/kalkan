{
  "type": "object",
  "additionalProperties": false,
  "$comment": "kalkan consolidate task result (docs/ENGINE-SPEC.md section 18). Every input id appears exactly once across groups[].ids and distinct[].id. The engine checks the quotes and picks the primary record of each group.",
  "required": [
    "task_id",
    "groups",
    "distinct"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^T[0-9]{4,}-consolidate$"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "$comment": "Records with the same root cause and the same fix. The evidence quotes the code that proves the shared root cause.",
        "required": [
          "ids",
          "reason",
          "evidence"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^KF-[0-9A-F]{16}$"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "line",
                "quote"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Target-relative POSIX path."
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Exact text from the cited line or the two lines around it."
                }
              }
            }
          }
        }
      }
    },
    "distinct": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^KF-[0-9A-F]{16}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true
          }
        }
      }
    }
  }
}
