      "near": [
        {
          "regex": "if\\s*\\(|skip|bypass|disable|return\\s+(true|next)|continue",
          "before": 3,
          "after": 2
        }
      ]
    },
    {
      "regex": "x-skip-auth",
      "flags": "i",
      "label": "x-skip-auth header — may bypass security in production",
      "near": [
        {
          "regex": "if\\s*\\(|skip|bypass|disable|return\\s+(true|next)|continue",
          "before": 3,
          "after": 2
        }
      ]
    },
    {
      "regex": "x-no-rate-limit",
      "flags": "i",
      "label": "x-no-rate-limit header — may bypass security in production",
      "near": [
        {
          "regex": "if\\s*\\(|skip|bypass|disable|return\\s+(true|next)|continue",
          "before": 3,
