      "flags": "i",
      "label": "test value in header check — may bypass security in production",
      "near": [
        {
          "regex": "if\\s*\\(|skip|bypass|disable|return\\s+(true|next)|continue",
          "before": 3,
          "after": 2
        }
      ]
    },
    {
