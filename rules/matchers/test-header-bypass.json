{
  "version": 1,
  "slug": "test-header-bypass",
  "description": "Test/debug headers that bypass security checks in production",
  "class": "authn",
  "cwe": [
    "CWE-288"
  ],
  "noise_tier": "precise",
  "file_patterns": [
    "**/*.{ts,tsx,js,jsx}"
  ],
  "exclude_file_patterns": [
    "**/*.{test,spec,mock,stub}.*",
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**"
  ],
  "requires": {
    "tech": [],
    "sentinel_files": [],
    "sentinel_contains": []
  },
  "patterns": [
    {
      "regex": "x-automated-test",
      "flags": "i",
      "label": "x-automated-test header — may bypass security in production",
      "near": [
        {
          "regex": "if\\s*\\(|skip|bypass|disable|return\\s+(true|next)|continue",
          "before": 3,
          "after": 2
        }
      ]
    },
    {
      "regex": "x-test-",
      "flags": "i",
      "label": "x-test-* header — may bypass security in production",
      "near": [
        {
          "regex": "if\\s*\\(|skip|bypass|disable|return\\s+(true|next)|continue",
          "before": 3,
