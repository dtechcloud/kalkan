{
  "version": 1,
  "slug": "php-slim-route",
  "description": "Slim Framework route registrations (gated on Slim)",
  "class": null,
  "cwe": [],
  "noise_tier": "noisy",
  "file_patterns": [
    "**/*.php"
  ],
  "exclude_file_patterns": [
    "**/{tests,vendor}/**"
  ],
  "requires": {
    "tech": [
      "php",
      "slim"
    ],
    "sentinel_files": [
      "**/composer.json"
    ],
    "sentinel_contains": [
      "\"slim/slim\""
    ]
  },
  "patterns": [
    {
      "regex": "\\$app->(?:get|post|put|patch|delete|map|any)\\s*\\(",
      "flags": "",
      "label": "$app->method route registration"
    },
    {
      "regex": "\\$app->group\\s*\\(",
      "flags": "",
      "label": "$app->group(...) middleware scope"
    },
    {
      "regex": "->add\\s*\\(\\s*new\\s+\\w+Middleware",
      "flags": "",
      "label": "->add(new ...Middleware) attach"
    },
    {
      "regex": "\\$request->(?:getQueryParams|getParsedBody|getAttribute)\\s*\\(",
      "flags": "",
      "label": "PSR-7 request accessor"
    }
  ],
  "examples": [
    "$app->get('/users', function ($request, $response) { return $response; });",
    "$app->post(\"/login\", LoginAction::class);",
    "$app->put('/items/{id}', $handler);",
    "$app->patch('/items/{id}', $handler);",
    "$app->delete('/items/{id}', $handler);",
    "$app->any('/health', $healthHandler);",
    "$app->map(['GET', 'POST'], '/x', $h);",
    "$app->group('/api', function ($group) { /* ... */ })->add(new AuthMiddleware());",
    "$app->add(new SessionMiddleware($settings));",
    "$body = $request->getParsedBody();",
    "$id = $request->getAttribute('id');",
    "$q = $request->getQueryParams();"
  ],
  "source": {
    "repo": "vercel-labs/deepsec",
    "commit": "4fa6722",
    "path": "packages/scanner/src/matchers/php-slim-route.ts"
  },
  "notes": "surface: enumerates entry points for review; no vulnerability class. Gate: deepsec tech [slim]; kalkan uses tech php (or slim) and a manifest that names slim."
}
