{
  "version": 1,
  "slug": "rb-rails-controller",
  "description": "Rails controllers, routes, and action methods (gated on Rails)",
  "class": null,
  "cwe": [],
  "noise_tier": "noisy",
  "file_patterns": [
    "**/app/controllers/**/*.rb",
    "**/config/routes.rb",
    "**/app/jobs/**/*.rb",
    "**/app/mailers/**/*.rb"
  ],
  "exclude_file_patterns": [
    "**/{test,spec,Test,Spec}/**",
    "**/{test,spec,Test,Spec}.*",
    "**/*{.,-}{test,spec,Test,Spec}.*",
    "**/{test,spec}-*/**",
    "**/*-{test,spec}/**"
  ],
  "requires": {
    "tech": [
      "rails"
    ],
    "sentinel_files": [],
    "sentinel_contains": []
  },
  "patterns": [
    {
      "regex": "^\\s*class\\s+\\w+Controller\\s*<\\s*\\w*Controller\\b",
      "flags": "m",
      "label": "Rails controller class"
    },
    {
      "regex": "^\\s*before_action\\s+",
      "flags": "m",
      "label": "before_action callback"
    },
    {
      "regex": "^\\s*skip_before_action\\s+",
      "flags": "m",
      "label": "skip_before_action (auth bypass — confirm intent)"
    },
    {
      "regex": "^\\s*resources\\s+:\\w+",
      "flags": "m",
      "label": "routes.rb resources :foo (CRUD)"
    },
    {
      "regex": "^\\s*(?:get|post|put|patch|delete|match)\\s+['\"][^'\"]+['\"]\\s*,",
      "flags": "m",
      "label": "routes.rb verb registration"
    },
    {
      "regex": "params\\.require\\s*\\(",
      "flags": "",
      "label": "strong params boundary"
    }
  ],
  "examples": [
    "class UsersController < ApplicationController",
    "class PostsController < BaseController",
    "  before_action :authenticate_user!, only: [:show, :edit]",
    "  skip_before_action :verify_authenticity_token",
    "resources :articles",
    "get \"/health\", to: \"health#index\"",
    "post '/login', to: 'sessions#create'",
    "match \"/legacy\", to: \"legacy#show\", via: [:get, :post]",
    "params.require(:user).permit(:email, :name)"
  ],
  "source": {
    "repo": "vercel-labs/deepsec",
    "commit": "4fa6722",
    "path": "packages/scanner/src/matchers/rb-rails-controller.ts"
  },
  "notes": "surface: enumerates entry points for review; no vulnerability class."
}
