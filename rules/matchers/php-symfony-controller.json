{
  "version": 1,
  "slug": "php-symfony-controller",
  "description": "Symfony controllers and route attributes (gated on Symfony)",
  "class": null,
  "cwe": [],
  "noise_tier": "noisy",
  "file_patterns": [
    "**/src/**/*.php",
    "**/src/Controller/**/*.php",
    "**/Controller/**/*.php"
  ],
  "exclude_file_patterns": [
    "**/{tests,vendor}/**"
  ],
  "requires": {
    "tech": [
      "symfony"
    ],
    "sentinel_files": [],
    "sentinel_contains": []
  },
  "patterns": [
    {
      "regex": "#\\[\\s*Route\\s*\\(",
      "flags": "",
      "label": "#[Route] attribute"
    },
    {
      "regex": "class\\s+\\w+Controller\\s+extends\\s+AbstractController\\b",
      "flags": "",
      "label": "Symfony controller class"
    },
    {
      "regex": "#\\[\\s*IsGranted\\s*\\(",
      "flags": "",
      "label": "#[IsGranted] auth gate"
    },
    {
      "regex": "#\\[\\s*AsEventListener\\s*\\(",
      "flags": "",
      "label": "Event listener entry point"
    },
    {
      "regex": "#\\[\\s*AsMessageHandler\\s*\\(",
      "flags": "",
      "label": "Messenger handler entry point"
    },
    {
      "regex": "\\$this->getUser\\s*\\(\\s*\\)",
      "flags": "",
      "label": "auth identity accessor"
    }
  ],
  "examples": [
    "#[Route('/users', name: 'users_index', methods: ['GET'])]",
    "#[ Route(\"/api/items/{id}\", methods: [\"GET\", \"POST\"]) ]",
    "class UsersController extends AbstractController { }",
    "class PostController extends AbstractController\n{\n    public function index(): Response {}\n}",
    "#[IsGranted('ROLE_ADMIN')]",
    "#[ IsGranted ( 'ROLE_USER' )]",
    "#[AsEventListener(event: 'kernel.request')]",
    "#[AsMessageHandler()]",
    "$user = $this->getUser();",
    "if ($this->getUser() === null) { throw new AccessDeniedException(); }"
  ],
  "source": {
    "repo": "vercel-labs/deepsec",
    "commit": "4fa6722",
    "path": "packages/scanner/src/matchers/php-symfony-controller.ts"
  },
  "notes": "surface: enumerates entry points for review; no vulnerability class."
}
