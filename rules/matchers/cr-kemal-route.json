{
  "version": 1,
  "slug": "cr-kemal-route",
  "description": "Crystal Kemal route handlers (gated on kemal)",
  "class": null,
  "cwe": [],
  "noise_tier": "noisy",
  "file_patterns": [
    "**/*.cr"
  ],
  "exclude_file_patterns": [
    "**/{spec,test}/**"
  ],
  "requires": {
    "tech": [],
    "sentinel_files": [
      "**/shard.yml"
    ],
    "sentinel_contains": [
      "\\bkemal\\b"
    ]
  },
  "patterns": [
    {
      "regex": "^\\s*(?:get|post|put|patch|delete|options|ws)\\s+\"[^\"]+\"\\s+do\\b",
      "flags": "m",
      "label": "Kemal <verb> '/path' do"
    },
    {
      "regex": "^\\s*before_(?:all|get|post|put|delete)\\s+do\\b",
      "flags": "m",
      "label": "before_* do — auth filter"
    },
    {
      "regex": "\\benv\\.params\\.(?:url|query|json|body|files)\\b",
      "flags": "",
      "label": "env.params accessor"
    }
  ],
  "examples": [
    "get \"/\" do\n  \"Hello World!\"\nend",
    "post \"/users\" do |env|\n  env.params.json[\"name\"]\nend",
    "put \"/users/:id\" do |env|\nend",
    "patch \"/users/:id\" do |env|\nend",
    "delete \"/users/:id\" do\nend",
    "options \"/users\" do\nend",
    "ws \"/chat\" do |socket|\nend",
    "before_all do |env|\n  env.response.content_type = \"application/json\"\nend",
    "before_get do |env|\n  env.response.content_type = \"application/json\"\nend",
    "before_post do |env|\nend",
    "before_put do\nend",
    "before_delete do\nend",
    "name = env.params.url[\"name\"]",
    "q = env.params.query[\"q\"]",
    "body = env.params.json[\"body\"]",
    "file = env.params.files[\"upload\"]"
  ],
  "source": {
    "repo": "vercel-labs/deepsec",
    "commit": "4fa6722",
    "path": "packages/scanner/src/matchers/cr-kemal-route.ts"
  },
  "notes": "surface: enumerates entry points for review; no vulnerability class. Gate: deepsec tech [kemal]; kalkan uses a shard.yml that names kemal."
}
