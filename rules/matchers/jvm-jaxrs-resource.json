{
  "version": 1,
  "slug": "jvm-jaxrs-resource",
  "description": "JAX-RS resources (Jersey, RESTEasy, Quarkus) — entry-point surface (gated on JAX-RS)",
  "class": null,
  "cwe": [],
  "noise_tier": "noisy",
  "file_patterns": [
    "**/*.{java,kt}"
  ],
  "exclude_file_patterns": [
    "**/{test,tests}/**"
  ],
  "requires": {
    "tech": [
      "java",
      "jaxrs"
    ],
    "sentinel_files": [
      "**/pom.xml",
      "**/build.gradle",
      "**/build.gradle.kts"
    ],
    "sentinel_contains": [
      "(?i:javax\\.ws\\.rs|jakarta\\.ws\\.rs|jersey|resteasy|quarkus)"
    ]
  },
  "patterns": [
    {
      "regex": "@Path\\s*\\(\\s*\"[^\"]+\"\\s*\\)",
      "flags": "",
      "label": "@Path declaration"
    },
    {
      "regex": "@(?:GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)\\b",
      "flags": "",
      "label": "JAX-RS method annotation"
    },
    {
      "regex": "@RolesAllowed\\s*\\(",
      "flags": "",
      "label": "@RolesAllowed auth gate"
    },
    {
      "regex": "@PermitAll\\b",
      "flags": "",
      "label": "@PermitAll opens public access"
    },
    {
      "regex": "@(?:Path|Query|Header|Form|Cookie)Param\\s*\\(",
      "flags": "",
      "label": "param extractor (untrusted)"
    }
  ],
  "examples": [
    "@Path(\"/users\")",
    "@Path ( \"/api/v1/items\" )",
    "@GET",
    "@POST",
    "@PUT",
    "@PATCH",
    "@DELETE",
    "@HEAD",
    "@OPTIONS",
    "@RolesAllowed(\"admin\")",
    "@PermitAll",
    "public User getUser(@PathParam(\"id\") String id) {",
    "void search(@QueryParam(\"q\") String q) {",
    "void custom(@HeaderParam(\"X-Auth\") String token) {",
    "void submit(@FormParam(\"name\") String name) {",
    "void session(@CookieParam(\"sid\") String sid) {"
  ],
  "source": {
    "repo": "vercel-labs/deepsec",
    "commit": "4fa6722",
    "path": "packages/scanner/src/matchers/jvm-jaxrs-resource.ts"
  },
  "notes": "surface: enumerates entry points for review; no vulnerability class. Gate: deepsec tech [jaxrs]; kalkan uses tech java (or jaxrs) and a manifest that names jaxrs."
}
