{
  "version": 1,
  "slug": "py-fastapi-route",
  "description": "FastAPI route handlers — entry points (gated on FastAPI)",
  "class": null,
  "cwe": [],
  "noise_tier": "noisy",
  "file_patterns": [
    "**/*.py"
  ],
  "exclude_file_patterns": [
    "**/{test,tests,Test,Tests}/**",
    "**/{test,tests,Test,Tests}.*",
    "**/*{.,-}{test,tests,Test,Tests}.*",
    "**/{test,tests}-*/**",
    "**/*-{test,tests}/**",
    "**/{migrations,Migrations}/**",
    "**/migrations.*"
  ],
  "requires": {
    "tech": [
      "fastapi"
    ],
    "sentinel_files": [],
    "sentinel_contains": []
  },
  "patterns": [
    {
      "regex": "^\\s*@(?:app|router|api)\\.(?:get|post|put|patch|delete|options|head|websocket)\\s*\\(",
      "flags": "m",
      "label": "FastAPI route decorator"
    },
    {
      "regex": "\\bAPIRouter\\s*\\(",
      "flags": "",
      "label": "APIRouter() factory"
    },
    {
      "regex": "=\\s*Depends\\s*\\(",
      "flags": "",
      "label": "Depends(...) dependency (auth gate when wired up)"
    },
    {
      "regex": "\\bSecurity\\s*\\(",
      "flags": "",
      "label": "Security(...) — auth dependency"
    }
  ],
  "examples": [
    "@app.get(\"/users\")",
    "@router.post(\"/items\", response_model=Item)",
    "@api.put(\"/things/{id}\")",
    "@app.delete(\"/users/{user_id}\")",
    "   @router.patch(\"/x\")",
    "@app.websocket(\"/ws\")",
    "router = APIRouter(prefix=\"/v1\")",
    "def read_user(user_id: int, current = Depends(get_current_user)):",
    "def admin(current_user = Security(get_current_active_user, scopes=[\"admin\"])):"
  ],
  "source": {
    "repo": "vercel-labs/deepsec",
    "commit": "4fa6722",
    "path": "packages/scanner/src/matchers/py-fastapi-route.ts"
  },
  "notes": "surface: enumerates entry points for review; no vulnerability class."
}
