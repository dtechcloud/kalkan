{
  "version": 1,
  "slug": "slack-signing-verification",
  "description": "Slack request handlers — verify HMAC signing + replay protection",
  "class": "webhook-replay",
  "cwe": [
    "CWE-345",
    "CWE-294"
  ],
  "noise_tier": "precise",
  "file_patterns": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.mjs"
  ],
  "exclude_file_patterns": [
    "**/*.{test,spec}.{ts,tsx,js,jsx,mjs,cjs}",
    "**/*.d.ts",
    "**/node_modules/**"
  ],
  "requires": {
    "tech": [],
    "sentinel_files": [],
    "sentinel_contains": []
  },
  "patterns": [
    {
      "regex": "\\bexport\\s+(?:async\\s+)?function\\s+(?:POST|GET|handle)\\b",
      "flags": "",
      "label": "Slack-context HTTP handler",
      "near": [
        {
          "regex": "\\bfrom\\s+[\"'](?:@slack/(?:bolt|web-api|events-api|interactive-messages|oauth)|slack-bolt)[\"']|\\bSlackRequestVerifier\\b|\\bverifySlackRequest\\b|\\bslack_signing_secret\\b|\\bSLACK_SIGNING_SECRET\\b",
          "scope": "file"
        }
      ]
    },
    {
      "regex": "\\bnew\\s+App\\s*\\(\\s*\\{[^}]*signingSecret\\s*:",
      "flags": "m",
      "label": "Slack Bolt App construction",
      "near": [
        {
          "regex": "\\bfrom\\s+[\"'](?:@slack/(?:bolt|web-api|events-api|interactive-messages|oauth)|slack-bolt)[\"']|\\bSlackRequestVerifier\\b|\\bverifySlackRequest\\b|\\bslack_signing_secret\\b|\\bSLACK_SIGNING_SECRET\\b",
          "scope": "file"
        }
