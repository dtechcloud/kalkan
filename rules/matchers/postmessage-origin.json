{
  "version": 1,
  "slug": "postmessage-origin",
  "description": "postMessage handlers without origin validation — XSS via malicious parent frame",
  "class": "xss",
  "cwe": [
    "CWE-346"
  ],
  "noise_tier": "precise",
  "file_patterns": [
    "**/*.{ts,tsx,js,jsx}"
  ],
  "exclude_file_patterns": [
    "**/*.{test,spec}.*"
  ],
  "requires": {
    "tech": [],
    "sentinel_files": [],
    "sentinel_contains": []
  },
  "file_contains": [
    "addEventListener.*message|onmessage"
  ],
  "patterns": [
    {
      "regex": "addEventListener\\s*\\(\\s*['\"]message['\"]|\\.onmessage\\s*=",
      "flags": "",
      "label": "postMessage handler with origin check (verify strictness)",
      "near": [
        {
          "regex": "event\\.origin|\\.origin\\s*[!=]==?|origin.*check",
          "after": 9
        }
      ]
    },
    {
      "regex": "addEventListener\\s*\\(\\s*['\"]message['\"]|\\.onmessage\\s*=",
      "flags": "",
      "label": "postMessage handler with origin check (verify strictness)",
      "near": [
        {
          "regex": "validat.*origin",
          "after": 9
        }
      ]
    },
    {
      "regex": "addEventListener\\s*\\(\\s*['\"]message['\"]|\\.onmessage\\s*=",
      "flags": "",
      "label": "postMessage handler WITHOUT origin validation",
      "not_near": [
        {
          "regex": "event\\.origin|\\.origin\\s*[!=]==?|origin.*check",
          "after": 9
        },
        {
          "regex": "validat.*origin",
          "after": 9
        }
      ]
    }
  ],
  "examples": [
    "window.addEventListener(\"message\", (event) => {\n  document.body.innerHTML = event.data;\n});",
    "window.addEventListener('message', handleMsg);",
    "iframe.onmessage = (e) => {\n  console.log(e.data);\n};",
    "frame.onmessage = function (e) { dispatch(e.data); };",
    "addEventListener(\"message\", function (event) {\n  if (event.origin !== \"https://trusted.example\") return;\n  doStuff(event.data);\n});"
  ],
  "source": {
    "repo": "vercel-labs/deepsec",
    "commit": "4fa6722",
    "path": "packages/scanner/src/matchers/postmessage-origin.ts"
  },
  "notes": "The origin check 'event\\.origin|\\.origin\\s*[!=]==?|origin.*check|validat.*origin' is split in two regexes (one wildcard each)."
}
