{
  "version": 1,
  "slug": "rs-poem-route",
  "description": "Poem route handlers (gated on Poem)",
  "class": null,
  "cwe": [],
  "noise_tier": "noisy",
  "file_patterns": [
    "**/*.rs"
  ],
  "exclude_file_patterns": [
    "**/{tests,examples}/**"
  ],
  "requires": {
    "tech": [
      "rust",
      "poem"
    ],
    "sentinel_files": [
      "**/Cargo.toml"
    ],
    "sentinel_contains": [
      "\\bpoem\\b"
    ]
  },
  "patterns": [
    {
      "regex": "\\bRoute::new\\s*\\(\\s*\\)\\.at\\s*\\(\\s*\"[^\"]+\"\\s*,",
      "flags": "",
      "label": "Route::new().at('/path', ...)"
    },
    {
      "regex": "#\\[\\s*handler\\s*\\]",
      "flags": "",
      "label": "#[handler] attribute"
    },
    {
      "regex": "\\bget\\s*\\(|post\\s*\\(|put\\s*\\(|patch\\s*\\(|delete\\s*\\(",
      "flags": "",
      "label": "handler verb wrapper"
    }
  ],
  "examples": [
    "let app = Route::new().at(\"/hello\", get(hello));",
    "Route::new().at(\"/users/:id\", get(show_user).post(update_user))",
    "Route::new().at(\"/login\", post(login_handler))",
    "#[handler]",
    "#[ handler ]",
    "let route = get(index);",
    "Route::new().at(\"/items\", post(create_item).delete(delete_item))",
    "let r = patch(handler);"
  ],
  "source": {
    "repo": "vercel-labs/deepsec",
    "commit": "4fa6722",
    "path": "packages/scanner/src/matchers/rs-poem-route.ts"
  },
  "notes": "surface: enumerates entry points for review; no vulnerability class. Gate: deepsec tech [poem]; kalkan uses tech rust (or poem) and a manifest that names poem."
}
