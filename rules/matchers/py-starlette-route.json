{
  "version": 1,
  "slug": "py-starlette-route",
  "description": "Starlette Route / Mount / WebSocketRoute declarations (gated on Starlette)",
  "class": null,
  "cwe": [],
  "noise_tier": "noisy",
  "file_patterns": [
    "**/*.py"
  ],
  "exclude_file_patterns": [
    "**/{test,tests,Test,Tests}/**",
    "**/{test,tests,Test,Tests}.*",
    "**/*{.,-}{test,tests,Test,Tests}.*",
    "**/{test,tests}-*/**",
    "**/*-{test,tests}/**",
    "**/{migrations,Migrations}/**",
    "**/migrations.*"
  ],
  "requires": {
    "tech": [
      "python",
      "starlette"
    ],
    "sentinel_files": [
      "**/requirements*.txt",
      "**/pyproject.toml",
      "**/Pipfile",
      "**/setup.py",
      "**/setup.cfg"
    ],
    "sentinel_contains": [
      "(?i:\\bstarlette\\b)"
    ]
  },
  "patterns": [
    {
      "regex": "\\bRoute\\s*\\(\\s*['\"][^'\"]+['\"]\\s*,",
      "flags": "",
      "label": "Route('/path', endpoint)"
    },
    {
      "regex": "\\bMount\\s*\\(\\s*['\"][^'\"]+['\"]\\s*,",
      "flags": "",
      "label": "Mount('/sub', app)"
    },
    {
      "regex": "\\bWebSocketRoute\\s*\\(",
      "flags": "",
      "label": "WebSocketRoute declaration"
    },
    {
      "regex": "\\bAuthenticationMiddleware\\b",
      "flags": "",
      "label": "AuthenticationMiddleware wiring"
    }
  ],
  "examples": [
    "    Route(\"/users\", endpoint=user_list),",
    "    Route('/items/{id}', items, methods=[\"GET\"]),",
    "    Mount(\"/static\", app=StaticFiles(directory=\"static\")),",
    "    Mount('/api', routes=api_routes),",
    "    WebSocketRoute(\"/ws\", endpoint=ws_endpoint),",
    "app.add_middleware(AuthenticationMiddleware, backend=BasicAuthBackend())",
    "from starlette.middleware.authentication import AuthenticationMiddleware"
  ],
  "source": {
    "repo": "vercel-labs/deepsec",
    "commit": "4fa6722",
    "path": "packages/scanner/src/matchers/py-starlette-route.ts"
  },
  "notes": "surface: enumerates entry points for review; no vulnerability class. Gate: deepsec tech [starlette]; kalkan uses tech python (or starlette) and a manifest that names starlette."
}
