{
  "version": 1,
  "slug": "error-message-leak",
  "description": "Error messages returned to client — may leak internal details",
  "class": "sensitive-data-exposure",
  "cwe": [
    "CWE-209"
  ],
  "noise_tier": "normal",
  "file_patterns": [
    "**/app/api/**/route.{ts,tsx}",
    "**/app/**/route.{ts,tsx}",
    "**/pages/api/**/*.{ts,tsx}",
    "**/routes/**/*.{ts,tsx}",
    "**/endpoints/**/*.{ts,tsx}"
  ],
  "exclude_file_patterns": [
    "**/*.{test,spec,mock,stub}.*",
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**"
  ],
  "requires": {
    "tech": [],
    "sentinel_files": [],
    "sentinel_contains": []
  },
  "patterns": [
    {
      "regex": "err(or)?\\.message",
      "flags": "",
      "label": "error.message in response — may leak internal details to client",
      "near": [
        {
          "regex": "Response\\.json|NextResponse\\.json|res\\.json|res\\.send|res\\.status|new Response|json\\s*\\(",
          "before": 3,
          "after": 2
        }
      ]
    },
    {
      "regex": "err(or)?\\.stack",
      "flags": "",
      "label": "error.stack in response — may leak internal details to client",
      "near": [
        {
          "regex": "Response\\.json|NextResponse\\.json|res\\.json|res\\.send|res\\.status|new Response|json\\s*\\(",
          "before": 3,
          "after": 2
        }
      ]
    },
    {
      "regex": "\\.toString\\(\\)",
      "flags": "",
      "label": "error.toString() in response — may leak internal details to client",
      "near": [
        {
          "regex": "Response\\.json|NextResponse\\.json|res\\.json|res\\.send|res\\.status|new Response|json\\s*\\(",
          "before": 3,
          "after": 2
        }
      ]
    },
    {
      "regex": "String\\(err",
      "flags": "",
      "label": "String(error) in response — may leak internal details to client",
      "near": [
        {
          "regex": "Response\\.json|NextResponse\\.json|res\\.json|res\\.send|res\\.status|new Response|json\\s*\\(",
          "before": 3,
          "after": 2
        }
      ]
    }
  ],
  "examples": [
    "try { run(); } catch (err) {\n  return Response.json({ error: err.message });\n}",
    "try { run(); } catch (error) {\n  return NextResponse.json({ message: error.message }, { status: 500 });\n}",
    "try { run(); } catch (err) {\n  return Response.json({ stack: err.stack });\n}",
    "try { run(); } catch (error) {\n  return res.json({ trace: error.stack });\n}",
    "try { run(); } catch (err) {\n  return res.send(err.toString());\n}",
    "try { run(); } catch (err) {\n  return Response.json({ error: String(err) });\n}"
  ],
  "source": {
    "repo": "vercel-labs/deepsec",
    "commit": "4fa6722",
    "path": "packages/scanner/src/matchers/error-message-leak.ts"
  },
  "notes": ""
}
