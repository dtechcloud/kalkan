{
  "version": 1,
  "slug": "framework-server-action",
  "description": "Server Action dispatcher / encoder / decoder code in the framework",
  "class": "deserialization",
  "cwe": [
    "CWE-502"
  ],
  "noise_tier": "precise",
  "file_patterns": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.mjs"
  ],
  "exclude_file_patterns": [
    "**/*.{test,spec}.{ts,tsx,js,jsx,mjs,cjs}",
    "**/*.d.ts"
  ],
  "requires": {
    "tech": [
      "next",
      "nextjs"
    ],
    "sentinel_files": [],
    "sentinel_contains": []
  },
  "patterns": [
    {
      "regex": "\\b(?:decodeReply|decodeAction|decodeFormState|encodeReply|parseAction|getActionFromManifest|callServer|parseActionId|registerServerReference)\\s*\\(",
      "flags": "",
      "label": "Server Action decode/dispatch call"
    },
    {
      "regex": "\\b__Next[-_]Action\\b",
      "flags": "",
      "label": "__Next-Action header"
    },
    {
      "regex": "['\"]next-action(?:-id|-redirect)?['\"]",
      "flags": "",
      "label": "next-action header name"
    },
    {
      "regex": "\\baction\\.id\\s*===|actionManifest\\b|actions\\.json\\b",
      "flags": "",
      "label": "action manifest lookup"
    }
  ],
  "examples": [
    "const result = decodeReply(body, manifest);",
    "const args = await decodeAction(formData, serverModuleMap);",
    "const state = decodeFormState(rawState, formData);",
    "const stream = encodeReply(value);",
    "const action = parseAction(request);",
    "const fn = getActionFromManifest(actionId, manifest);",
    "await callServer(actionId, args);",
    "const id = parseActionId(headers.get('next-action'));",
    "registerServerReference(actionFn, actionId, null);",
    "const header = req.headers['__Next-Action'];",
    "const id = req.headers.get('next-action-id');",
    "if (action.id === actionId) { /* dispatch */ }",
    "import actionManifest from './actions.json'"
  ],
  "source": {
    "repo": "vercel-labs/deepsec",
    "commit": "4fa6722",
    "path": "packages/scanner/src/matchers/js-nextjs-fw-server-action.ts"
  },
  "notes": "deepsec labels with the first 40 characters of the regex; the port uses descriptive labels. The path-only fallback (flag line 1 of action-handler files without content hits) is dropped. The upstream header regex starts with \\b before a quote, which cannot match after '(' or a space; the port drops that \\b, so the upstream example get('next-action-id') matches. Gate: deepsec tech [nextjs]; kalkan uses the tech tag next (or nextjs)."
}
