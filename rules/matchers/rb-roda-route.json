{
  "version": 1,
  "slug": "rb-roda-route",
  "description": "Roda route trees (gated on Roda)",
  "class": null,
  "cwe": [],
  "noise_tier": "noisy",
  "file_patterns": [
    "**/*.rb"
  ],
  "exclude_file_patterns": [
    "**/{test,spec,Test,Spec}/**",
    "**/{test,spec,Test,Spec}.*",
    "**/*{.,-}{test,spec,Test,Spec}.*",
    "**/{test,spec}-*/**",
    "**/*-{test,spec}/**"
  ],
  "requires": {
    "tech": [
      "ruby",
      "roda"
    ],
    "sentinel_files": [
      "**/Gemfile",
      "**/Gemfile.lock",
      "**/*.gemspec"
    ],
    "sentinel_contains": [
      "\\broda\\b"
    ]
  },
  "patterns": [
    {
      "regex": "^class\\s+\\w+\\s*<\\s*Roda\\b",
      "flags": "m",
      "label": "class < Roda app"
    },
    {
      "regex": "\\br\\.(?:get|post|put|patch|delete|on|is|root)\\b",
      "flags": "",
      "label": "r.<verb>/r.on/r.is route node"
    },
    {
      "regex": "\\bplugin\\s+:[\\w_]+",
      "flags": "",
      "label": "Roda plugin (auth/security/render)"
    }
  ],
  "examples": [
    "class App < Roda",
    "class Api < Roda",
    "  r.get \"users\" do",
    "  r.post \"login\" do",
    "  r.put \"items\", Integer do |id|",
    "  r.patch \"profile\" do",
    "  r.delete \"sessions\" do",
    "  r.on \"api\" do",
    "  r.is \"healthz\" do",
    "  r.root do",
    "plugin :render",
    "plugin :json_parser"
  ],
  "source": {
    "repo": "vercel-labs/deepsec",
    "commit": "4fa6722",
    "path": "packages/scanner/src/matchers/rb-roda-route.ts"
  },
  "notes": "surface: enumerates entry points for review; no vulnerability class. Gate: deepsec tech [roda]; kalkan uses tech ruby (or roda) and a manifest that names roda."
}
