{
  "version": 1,
  "slug": "go-gorilla-route",
  "description": "Gorilla mux router registrations (gated on gorilla)",
  "class": null,
  "cwe": [],
  "noise_tier": "noisy",
  "file_patterns": [
    "**/*.go"
  ],
  "exclude_file_patterns": [
    "**/*_test.go"
  ],
  "requires": {
    "tech": [
      "go",
      "gorilla"
    ],
    "sentinel_files": [
      "**/go.mod"
    ],
    "sentinel_contains": [
      "github\\.com/gorilla/mux"
    ]
  },
  "patterns": [
    {
      "regex": "\\bmux\\.NewRouter\\s*\\(\\s*\\)",
      "flags": "",
      "label": "mux.NewRouter() init"
    },
    {
      "regex": "\\.HandleFunc\\s*\\(\\s*\"[^\"]+\"\\s*,",
      "flags": "",
      "label": "router.HandleFunc('/path', handler)"
    },
    {
      "regex": "\\.Methods\\s*\\(\\s*\"(?:GET|POST|PUT|PATCH|DELETE)\"",
      "flags": "",
      "label": ".Methods('VERB')"
    },
    {
      "regex": "\\.PathPrefix\\s*\\(",
      "flags": "",
      "label": ".PathPrefix() subroute scope"
    },
    {
      "regex": "\\bmux\\.Vars\\s*\\(\\s*r\\s*\\)",
      "flags": "",
      "label": "mux.Vars(r) (untrusted input)"
    }
  ],
  "examples": [
    "r := mux.NewRouter()",
    "r.HandleFunc(\"/users\", listUsers)",
    "router.HandleFunc(\"/login\", login).Methods(\"POST\")",
    "s.HandleFunc(\"/items/{id}\", updateItem).Methods(\"PUT\")",
    "r.HandleFunc(\"/items/{id}\", patchItem).Methods(\"PATCH\")",
    "r.HandleFunc(\"/items/{id}\", deleteItem).Methods(\"DELETE\")",
    "api := r.PathPrefix(\"/api\").Subrouter()",
    "vars := mux.Vars(r)"
  ],
  "source": {
    "repo": "vercel-labs/deepsec",
    "commit": "4fa6722",
    "path": "packages/scanner/src/matchers/go-gorilla-route.ts"
  },
  "notes": "surface: enumerates entry points for review; no vulnerability class. Gate: deepsec tech [gorilla]; kalkan uses tech go (or gorilla) and a manifest that names gorilla."
}
