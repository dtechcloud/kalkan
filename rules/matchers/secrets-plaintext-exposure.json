{
  "version": 1,
  "slug": "secrets-plaintext-exposure",
  "description": "Decrypted plaintext flowing into logs, HTTP responses, errors, or traces",
  "class": "sensitive-data-exposure",
  "cwe": [
    "CWE-532",
    "CWE-200"
  ],
  "noise_tier": "precise",
  "file_patterns": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.mjs",
    "**/*.go"
  ],
  "exclude_file_patterns": [
    "**/*.{test,spec}.{ts,tsx,js,jsx,mjs,cjs}",
    "**/*_test.go",
    "**/*.d.ts",
    "**/__{tests,mocks}__/**"
  ],
  "requires": {
    "tech": [],
    "sentinel_files": [],
    "sentinel_contains": []
  },
  "patterns": [
    {
      "regex": "\\b(?:console\\.(?:log|info|warn|error|debug)|logger\\.(?:info|warn|error|debug|fatal|trace)|log\\.(?:Info|Warn|Error|Debug|Printf|Println)|ngx\\.log|zap\\.(?:String|Any|Error)|fmt\\.(?:Errorf|Printf|Println)|span\\.(?:setAttribute|setAttributes|addEvent|recordException)|res\\.(?:send|json|write|end)|response\\.(?:send|json|write|end)|reply\\.(?:send|code)|ctx\\.(?:body|reply)|throw\\s+new\\s+\\w*Error|new\\s+Error)\\s*\\(",
      "flags": "",
      "label": "plaintext reference inside logger/response/error/span call",
      "near": [
        {
          "regex": "\\b(?:plaintext|decryptedValue|decryptedSecret|decryptedEnv|decryptResponse\\.plaintext|nowDecryptResponse\\.plaintext|decrypted\\w*)\\b",
          "after": 3
        }
      ],
      "not_near": [
        {
          "regex": "plaintext\\s*\\.\\s*length\\b",
          "after": 3
        }
      ]
    },
    {
      "regex": "\\b(?:console\\.(?:log|info|warn|error|debug)|logger\\.(?:info|warn|error|debug|fatal|trace)|log\\.(?:Info|Warn|Error|Debug|Printf|Println)|ngx\\.log|zap\\.(?:String|Any|Error)|fmt\\.(?:Errorf|Printf|Println)|span\\.(?:setAttribute|setAttributes|addEvent|recordException)|res\\.(?:send|json|write|end)|response\\.(?:send|json|write|end)|reply\\.(?:send|code)|ctx\\.(?:body|reply)|throw\\s+new\\s+\\w*Error|new\\s+Error)\\s*\\(",
      "flags": "",
      "label": "plaintext reference inside logger/response/error/span call",
      "near": [
        {
          "regex": "\\b(?:plaintext|decryptedValue|decryptedSecret|decryptedEnv|decryptResponse\\.plaintext|nowDecryptResponse\\.plaintext|decrypted\\w*)\\b",
          "after": 3
        },
        {
          "regex": "plaintext\\s*[,)]",
          "after": 3
        }
      ]
    }
  ],
  "examples": [
    "console.log(plaintext);",
    "console.info(decryptedValue);",
    "console.warn(decryptedSecret);",
    "console.error(decryptedEnv);",
    "console.debug(decryptResponse.plaintext);",
    "logger.info({ plaintext });",
    "logger.error(\"got\", decryptedSecret);",
    "log.Info(\"plaintext=\", plaintext)",
    "log.Printf(\"got %s\", plaintext)",
    "ngx.log(ngx.ERR, plaintext)",
    "zap.String(\"v\", plaintext)",
    "fmt.Errorf(\"err: %s\", plaintext)",
    "fmt.Println(decryptedValue)",
    "span.setAttribute(\"v\", plaintext);",
    "span.recordException(decryptedSecret);",
    "res.json({ value: decryptResponse.plaintext });",
    "response.send(plaintext);",
    "reply.send(decryptedValue);",
    "ctx.body(plaintext);",
    "throw new Error(`failed: ${plaintext}`);",
    "new Error(plaintext);"
  ],
  "source": {
    "repo": "vercel-labs/deepsec",
    "commit": "4fa6722",
    "path": "packages/scanner/src/matchers/secrets-plaintext-exposure.ts"
  },
  "notes": "The '.length' exception is split in two patterns: flag when the window has no 'plaintext.length', or when it also passes plaintext directly (as upstream)."
}
