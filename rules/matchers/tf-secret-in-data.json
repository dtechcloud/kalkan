{
  "version": 1,
  "slug": "tf-secret-in-data",
  "description": "kubernetes_secret resource with hardcoded plaintext value in data block",
  "class": "hardcoded-secrets",
  "cwe": [
    "CWE-798"
  ],
  "noise_tier": "precise",
  "file_patterns": [
    "**/*.tf"
  ],
  "exclude_file_patterns": [],
  "requires": {
    "tech": [
      "terraform"
    ],
    "sentinel_files": [],
    "sentinel_contains": []
  },
  "patterns": [
    {
      "regex": "^\\s*[\\w-]+\\s*=\\s*\"(?![^\"]*\\$\\{)(?!(?:default|true|false|enabled|disabled|none|public|private)\")[^\"]{8,}\\\"",
      "flags": "i",
      "label": "kubernetes_secret.data with literal value",
      "near": [
        {
          "regex": "^\\s*resource\\s+\"kubernetes_secret(?:_v1)?\"\\s+",
          "before": 30
        },
        {
          "regex": "^\\s*data\\s*=?\\s*\\{",
          "before": 15
        }
      ]
    }
  ],
  "examples": [
    "resource \"kubernetes_secret\" \"db\" {\n  metadata { name = \"db\" }\n  data = {\n    password = \"supersecret-plaintext-value\"\n  }\n}",
    "resource \"kubernetes_secret_v1\" \"api\" {\n  metadata { name = \"api\" }\n  data = {\n    api_key = \"AKIAIOSFODNN7EXAMPLE\"\n  }\n}",
    "resource \"kubernetes_secret\" \"tokens\" {\n  metadata { name = \"tokens\" }\n  data = {\n    token = \"REDACTED-plaintext-token-value-goes-here\"\n  }\n}"
  ],
  "source": {
    "repo": "vercel-labs/deepsec",
    "commit": "4fa6722",
    "path": "packages/scanner/src/matchers/tf-secret-in-data.ts"
  },
  "notes": "Brace tracking is approximated: the literal must be within 15 lines after a 'data = {' line and 30 lines after a kubernetes_secret resource line."
}
