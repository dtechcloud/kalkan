{
  "version": 1,
  "slug": "go-gin-route",
  "description": "Gin route registrations and group middleware (gated on Gin)",
  "class": null,
  "cwe": [],
  "noise_tier": "noisy",
  "file_patterns": [
    "**/*.go"
  ],
  "exclude_file_patterns": [
    "**/*_test.go"
  ],
  "requires": {
    "tech": [
      "go",
      "gin"
    ],
    "sentinel_files": [
      "**/go.mod"
    ],
    "sentinel_contains": [
      "github\\.com/gin-gonic/gin"
    ]
  },
  "patterns": [
    {
      "regex": "\\b(?:r|router|engine|api|v\\d+)\\.(?:GET|POST|PUT|PATCH|DELETE|Any|Handle)\\s*\\(",
      "flags": "",
      "label": "Gin method registration"
    },
    {
      "regex": "\\.Group\\s*\\(",
      "flags": "",
      "label": "Gin .Group (middleware scope)"
    },
    {
      "regex": "gin\\.Default\\s*\\(\\s*\\)|gin\\.New\\s*\\(\\s*\\)",
      "flags": "",
      "label": "Gin engine init"
    },
    {
      "regex": "\\bc\\.(?:Query|Param|PostForm|GetHeader|ShouldBind\\w*)\\b",
      "flags": "",
      "label": "Request data accessor (untrusted input)"
    }
  ],
  "examples": [
    "r := gin.Default()",
    "engine := gin.New()",
    "r.GET(\"/users\", listUsers)",
    "router.POST(\"/login\", loginHandler)",
    "api.PUT(\"/items/:id\", updateItem)",
    "v1.PATCH(\"/profile\", patchProfile)",
    "engine.DELETE(\"/sessions/:id\", logout)",
    "r.Any(\"/proxy\", proxyHandler)",
    "r.Handle(\"OPTIONS\", \"/cors\", corsHandler)",
    "admin := r.Group(\"/admin\")",
    "id := c.Query(\"id\")",
    "name := c.Param(\"name\")",
    "email := c.PostForm(\"email\")",
    "auth := c.GetHeader(\"Authorization\")",
    "if err := c.ShouldBindJSON(&body); err != nil {}"
  ],
  "source": {
    "repo": "vercel-labs/deepsec",
    "commit": "4fa6722",
    "path": "packages/scanner/src/matchers/go-gin-route.ts"
  },
  "notes": "surface: enumerates entry points for review; no vulnerability class. Gate: deepsec tech [gin]; kalkan uses tech go (or gin) and a manifest that names gin."
}
