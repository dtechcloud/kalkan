{
  "version": 1,
  "slug": "algorithm-confusion",
  "description": "JWT verification without algorithm pinning — algorithm confusion attack risk",
  "class": "jwt",
  "cwe": [
    "CWE-347"
  ],
  "noise_tier": "precise",
  "file_patterns": [
    "**/*.{ts,tsx,js,jsx,lua}"
  ],
  "exclude_file_patterns": [
    "**/*.{test,spec}.*"
  ],
  "requires": {
    "tech": [],
    "sentinel_files": [],
    "sentinel_contains": []
  },
  "file_contains": [
    "jwt\\.verify|jwtVerify|verifyJwt|jwt_obj:verify|resty\\.jwt"
  ],
  "patterns": [
    {
      "regex": "jwt\\.verify|jwtVerify|verifyJwt|jwt_obj:verify",
      "flags": "",
      "label": "JWT verification WITHOUT algorithm pinning — algorithm confusion risk",
      "not_near": [
        {
          "regex": "algorithms?\\s*:|alg.*(?:RS|HS|ES)256",
          "after": 4
        }
      ]
    },
    {
      "regex": "jwt\\.verify|jwtVerify|verifyJwt|jwt_obj:verify",
      "flags": "",
      "label": "JWT verification with algorithm pin (verify correct algorithm)",
      "near": [
        {
          "regex": "algorithms?\\s*:|alg.*(?:RS|HS|ES)256",
          "after": 4
        }
      ]
    }
  ],
  "examples": [
    "const decoded = jwt.verify(token, secret);",
    "const result = await jwtVerify(token, key);",
    "const claims = verifyJwt(token, publicKey);",
    "local ok = jwt_obj:verify(secret, token)",
    "jwt.verify(token, key, { algorithms: [\"RS256\"] });",
    "await jwtVerify(token, jwks, { algorithm: \"HS256\" });"
  ],
  "source": {
    "repo": "vercel-labs/deepsec",
    "commit": "4fa6722",
    "path": "packages/scanner/src/matchers/algorithm-confusion.ts"
  },
  "notes": "The pin check 'algorithms\\s*:|algorithm\\s*:|alg.*RS256|alg.*HS256|alg.*ES256' is rewritten to the equivalent 'algorithms?\\s*:|alg.*(?:RS|HS|ES)256' (one wildcard)."
}
