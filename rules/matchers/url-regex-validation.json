{
  "version": 1,
  "slug": "url-regex-validation",
  "description": "Regex-based URL/hostname validation with .+ or .* patterns — bypassable",
  "class": "ssrf",
  "cwe": [
    "CWE-185"
  ],
  "noise_tier": "precise",
  "file_patterns": [
    "**/*.{ts,tsx,js,jsx}"
  ],
  "exclude_file_patterns": [
    "**/*.{test,spec}.*"
  ],
  "requires": {
    "tech": [],
    "sentinel_files": [],
    "sentinel_contains": []
  },
  "patterns": [
    {
      "regex": "https?.*\\.[+*]",
      "flags": "",
      "label": "URL validation regex with greedy wildcard (.+ or .*) — may be bypassable",
      "near": [
        {
          "regex": "RegExp|/.*/|\\.test|\\.match"
        }
      ]
    },
    {
      "regex": "new RegExp\\s*\\(.*https?",
      "flags": "",
      "label": "URL validation regex with greedy wildcard (.+ or .*) — may be bypassable"
    },
    {
      "regex": "/\\^?https?:.*\\.\\+[^/]*/",
      "flags": "",
      "label": "URL validation regex with greedy wildcard (.+ or .*) — may be bypassable"
    },
    {
      "regex": "new\\s+URL\\s*\\(",
      "flags": "",
      "label": "new URL() from request input without hostname validation",
      "near": [
        {
          "regex": "req\\.|params\\.|query\\.|body\\.|parsed\\."
        }
      ],
      "not_near": [
        {
          "regex": "\\.hostname\\s*===|\\.host\\s*===",
          "after": 4
        }
      ]
    }
  ],
  "examples": [
    "const re = new RegExp(\"https?://.+\\\\.example\\\\.com\");\nif (re.test(url)) ok();",
    "if (/^https?:\\/\\/.+\\.trusted\\.com/.test(url)) ok();",
    "const ok = /https?:.+\\.example\\.com/.test(url);",
    "const re = /https?:.*\\.foo\\.com/;\nif (re.test(url)) good();",
    "const u = new URL(req.query.target);",
    "const u = new URL(params.url);",
    "const u = new URL(body.callbackUrl);"
  ],
  "source": {
    "repo": "vercel-labs/deepsec",
    "commit": "4fa6722",
    "path": "packages/scanner/src/matchers/url-regex-validation.ts"
  },
  "notes": "Equivalent one-wildcard rewrites: 'https?.*\\.\\+|https?.*\\.\\*' becomes 'https?.*\\.[+*]' and '\\/\\^?https?:.*\\.\\+.*\\/' becomes '/\\^?https?:.*\\.\\+[^/]*/'."
}
