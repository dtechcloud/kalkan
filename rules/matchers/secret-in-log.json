{
  "version": 1,
  "slug": "secret-in-log",
  "description": "Credentials or tokens appearing in log statements or error messages returned to callers",
  "class": "sensitive-data-exposure",
  "cwe": [
    "CWE-532"
  ],
  "noise_tier": "precise",
  "file_patterns": [
    "**/*.{ts,tsx,js,jsx}"
  ],
  "exclude_file_patterns": [
    "**/*.{test,spec}.*"
  ],
  "requires": {
    "tech": [],
    "sentinel_files": [],
    "sentinel_contains": []
  },
  "patterns": [
    {
      "regex": "console\\.(log|error|warn|info)\\s*\\(|logger\\.\\w+\\s*\\(|migrationsLogger\\.\\w+\\s*\\(|log\\.\\w+\\s*\\(|\\{\\s*(token|secret|apiKey|password|credential|accessToken|refreshToken)\\s*[,}:]|JSON\\.stringify\\s*\\(.*\\b(token|secret|key|password)\\b",
      "flags": "",
      "label": "Secret variable in log statement",
      "near": [
        {
          "regex": "\\b(token|accessToken|refreshToken|secret|apiKey|api_key|password|credential|privateKey|bearerToken)\\b"
        }
      ]
    },
    {
      "regex": "throw\\s+new\\s+\\w*Error\\s*\\(|res\\.(json|send|status)\\s*\\(",
      "flags": "",
      "label": "Secret variable in error response",
      "near": [
        {
          "regex": "\\b(token|accessToken|refreshToken|secret|apiKey|api_key|password|credential|privateKey|bearerToken)\\b"
        }
      ]
    },
    {
      "regex": "return.{0,200}\\{.*error",
      "flags": "",
      "label": "Secret variable in error response",
      "near": [
        {
          "regex": "\\b(token|accessToken|refreshToken|secret|apiKey|api_key|password|credential|privateKey|bearerToken)\\b"
        }
      ]
    },
    {
      "regex": "return.{0,200}message.*:",
      "flags": "",
      "label": "Secret variable in error response",
      "near": [
        {
          "regex": "\\b(token|accessToken|refreshToken|secret|apiKey|api_key|password|credential|privateKey|bearerToken)\\b"
        }
      ]
    }
  ],
  "examples": [
    "console.log(\"token\", token);",
    "console.error(\"failed:\", apiKey);",
    "console.warn(\"auth\", refreshToken);",
    "console.info(\"got\", accessToken);",
    "logger.info({ secret });",
    "logger.error({ password });",
    "migrationsLogger.warn({ apiKey });",
    "log.debug({ credential });",
    "({ token, foo })",
    "({ secret: v })",
    "JSON.stringify({ token: t });",
    "throw new Error(\"token=\" + token);",
    "res.json({ token });",
    "res.send({ secret });",
    "return { error: \"missing token\" };",
    "return { message: \"credential rejected\" };"
  ],
  "source": {
    "repo": "vercel-labs/deepsec",
    "commit": "4fa6722",
    "path": "packages/scanner/src/matchers/secret-in-log.ts"
  },
  "notes": "'return.*\\{.*error|return.*message.*:' has two wildcards per branch: each branch becomes a pattern and its first wildcard is bounded to 200 characters."
}
