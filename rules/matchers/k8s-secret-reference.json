{
  "version": 1,
  "slug": "k8s-secret-reference",
  "description": "K8s manifest references a Secret (secretKeyRef, secretName, ExternalSecret, etc.)",
  "class": "iac-cloud-container",
  "cwe": [
    "CWE-312"
  ],
  "noise_tier": "normal",
  "file_patterns": [
    "**/*.yaml",
    "**/*.yml"
  ],
  "exclude_file_patterns": [
    "**/{node_modules,vendor,charts,.github}/**"
  ],
  "requires": {
    "tech": [],
    "sentinel_files": [],
    "sentinel_contains": []
  },
  "patterns": [
    {
      "regex": "^\\s*(?:-\\s*)?secretKeyRef\\s*:",
      "flags": "",
      "label": "env.valueFrom.secretKeyRef"
    },
    {
      "regex": "^\\s*secretName\\s*:\\s*\\S",
      "flags": "",
      "label": "volumes.secret.secretName"
    },
    {
      "regex": "^\\s*kind\\s*:\\s*(?:Secret|ExternalSecret|SealedSecret|ClusterSecretStore|SecretStore)\\b",
      "flags": "",
      "label": "Secret kind manifest"
    },
    {
      "regex": "\\bexternal-secrets\\.io/",
      "flags": "",
      "label": "external-secrets.io CRD"
    },
    {
      "regex": "\\bvault\\.hashicorp\\.com/agent-inject\\b",
      "flags": "",
      "label": "vault-injector annotation"
    },
    {
      "regex": "\\bsecrets-init-container\\b",
      "flags": "",
      "label": "secrets-init-container reference"
    },
    {
      "regex": "^\\s*stringData\\s*:",
      "flags": "",
      "label": "Secret stringData (plaintext in manifest!)"
    },
    {
      "regex": "^\\s*value\\s*:\\s*(?:['\"]?[A-Za-z0-9+/=_-]{24,})",
      "flags": "",
      "label": "env.value literal (possibly a secret)"
    }
  ],
  "examples": [
    "env:\n  - name: DB_PASSWORD\n    valueFrom:\n      secretKeyRef:\n        name: db\n        key: password",
    "volumes:\n  - name: certs\n    secret:\n      secretName: tls-certs",
    "apiVersion: v1\nkind: Secret\nmetadata:\n  name: db\ntype: Opaque",
    "apiVersion: external-secrets.io/v1beta1\nkind: ExternalSecret\nmetadata:\n  name: db",
    "metadata:\n  annotations:\n    vault.hashicorp.com/agent-inject: \"true\"",
    "spec:\n  containers:\n    - image: ghcr.io/example/secrets-init-container:v1\n      name: init",
    "apiVersion: v1\nkind: Secret\nstringData:\n  password: hunter2-very-secret",
    "env:\n  - name: API_TOKEN\n    value: \"AKIAIOSFODNN7EXAMPLE_aws_access_key\""
  ],
  "source": {
    "repo": "vercel-labs/deepsec",
    "commit": "4fa6722",
    "path": "packages/scanner/src/matchers/k8s-secret-reference.ts"
  },
  "notes": "'^\\s*-?\\s*secretKeyRef' becomes the equivalent '^\\s*(?:-\\s*)?secretKeyRef' (two adjacent \\s* backtrack quadratically on a long blank line)."
}
