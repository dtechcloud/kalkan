      "near": [
        {
          "regex": "JSON\\.stringify",
          "before": 3,
          "after": 2
        }
      ],
      "not_near": [
        {
          "regex": "safeJsonStringify",
          "scope": "file"
        }
      ]
    },
    {
      "regex": "dangerouslySetInnerHTML",
