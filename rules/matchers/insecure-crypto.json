{
  "version": 1,
  "slug": "insecure-crypto",
  "description": "Weak cryptographic algorithms and insecure random number generation",
  "class": "crypto",
  "cwe": [
    "CWE-327",
    "CWE-338",
    "CWE-208"
  ],
  "noise_tier": "noisy",
  "file_patterns": [
    "**/*.{ts,tsx,js,jsx}"
  ],
  "exclude_file_patterns": [
    "**/*.{test,spec}.*"
  ],
  "requires": {
    "tech": [],
    "sentinel_files": [],
    "sentinel_contains": []
  },
  "patterns": [
    {
      "regex": "createHash\\s*\\(\\s*['\"]md5['\"]",
      "flags": "",
      "label": "MD5 hash"
    },
    {
      "regex": "createHash\\s*\\(\\s*['\"]sha1['\"]",
      "flags": "",
      "label": "SHA1 hash"
    },
    {
      "regex": "createCipher\\s*\\(",
      "flags": "",
      "label": "deprecated createCipher (use createCipheriv)"
    },
    {
      "regex": "DES|RC4|Blowfish",
      "flags": "i",
      "label": "weak cipher algorithm"
    },
    {
      "regex": "\\bmd5\\s*\\(",
      "flags": "",
      "label": "MD5 function call"
    },
    {
      "regex": "===?\\s*.{0,40}\\bhmac\\b|\\bhmac\\b.{0,40}===?",
      "flags": "",
      "label": "Timing-unsafe HMAC comparison (use timingSafeEqual)"
    },
    {
      "regex": "===?\\s*.{0,40}\\bdigest\\b|\\bdigest\\b.{0,40}===?",
      "flags": "",
      "label": "Timing-unsafe digest comparison"
    },
    {
      "regex": "===?\\s*.{0,40}\\bsignature\\b|\\bsignature\\b.{0,40}===?",
      "flags": "",
      "label": "Timing-unsafe signature comparison"
    },
    {
      "regex": "Math\\.random\\s*\\(",
      "flags": "",
      "label": "Math.random in security context",
      "near": [
        {
          "regex": "\\b(token|secret|key|password|nonce|salt|session|csrf|auth|credential|hash)\\b",
          "flags": "i",
          "scope": "file"
        }
      ]
    }
  ],
  "examples": [
    "crypto.createHash(\"md5\").update(s).digest();",
    "crypto.createHash('sha1').update(s);",
    "crypto.createCipher(\"aes\", key);",
    "const cipher = \"DES\";",
    "const algo = \"RC4\";",
    "const algo = \"Blowfish\";",
    "const h = md5(input);",
    "if (computed === hmac) { ok(); }",
    "if (digest === expected) { return; }",
    "if (signature == provided) { return; }",
    "const token = Math.random().toString(36);"
  ],
  "source": {
    "repo": "vercel-labs/deepsec",
    "commit": "4fa6722",
    "path": "packages/scanner/src/matchers/insecure-crypto.ts"
  },
  "notes": ""
}
